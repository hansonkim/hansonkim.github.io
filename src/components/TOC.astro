---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <div class="toc-mobile">
    <button class="toc-mobile-toggle" id="toc-mobile-toggle" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      목차
    </button>
    <div class="toc-mobile-content" id="toc-mobile-content">
      <ul class="toc-list">
        {filtered.map((h) => (
          <li>
            <a href={`#${h.slug}`} class:list={[{ 'depth-3': h.depth === 3 }]}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}

<script>
  function initToc() {
    const mobileToggle = document.getElementById('toc-mobile-toggle');
    const mobileContent = document.getElementById('toc-mobile-content');

    mobileToggle?.addEventListener('click', () => {
      mobileToggle.classList.toggle('open');
      mobileContent?.classList.toggle('open');
    });
  }

  initToc();
  document.addEventListener('astro:after-swap', initToc);
</script>
