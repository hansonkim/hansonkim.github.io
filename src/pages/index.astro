---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'node:child_process';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const recentCommits = execSync('git log --oneline --decorate -5', {
  encoding: 'utf8',
  stdio: ['ignore', 'pipe', 'ignore'],
})
  .trim()
  .split('\n');

function getReadingTime(body: string) {
  return Math.ceil(body.split(/\s+/).length / 200) + '분 읽기';
}
---

<BaseLayout title="Hanson's Blog">
  <section class="hero">
    <div class="home-shell">
      <div class="hero-copy">
        <p class="eyebrow">release terminal / github pages</p>
        <h1>Hanson's Blog</h1>
        <p>AI 도구, 개발 워크플로, 검증 기록을 릴리즈 노트처럼 정리합니다.</p>
        <div class="hero-actions">
          <a href="/blog" class="hero-link">블로그 보기</a>
          <a href="/rss.xml" class="hero-link secondary">RSS</a>
        </div>
      </div>

      <aside class="release-panel" aria-label="최근 변경 로그">
        <div class="terminal-bar">
          <span></span><span></span><span></span>
        </div>
        <div class="command-line">
          <span>$</span>
          <code>git log --oneline --decorate -5</code>
        </div>
        <ol class="commit-list">
          {recentCommits.map((commit) => (
            <li><code>{commit}</code></li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="home-shell latest-section">
      <div class="section-header">
        <p class="eyebrow">latest artifacts</p>
        <h2 class="section-title">최근 글</h2>
      </div>
      <div class="blog-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            tags={post.data.tags}
            category={post.data.category}
            readingTime={post.body ? getReadingTime(post.body) : '1분 읽기'}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
